pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                sh 'python app.py'  // Replace with your build/test command
            }
        }

        stage('Deploy') {
            steps {
                sh 'cp app.py /var/www/html/app.py'
                sh 'python /var/www/html/app.py'
            }
        }
    }

    triggers {
        pollSCM('* * * * *')  // Optional: poll every minute
    }
}
